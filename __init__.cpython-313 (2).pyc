"""
Feature Engineering Module
===========================
Extracts three categories of features from review text:
1. TF-IDF features (word-level and character-level)
2. Linguistic / Stylometric features
3. Combined feature matrix

These features capture both content and writing style to distinguish
genuine from fake reviews.
"""

import os
import re
import numpy as np
import pandas as pd
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.preprocessing import StandardScaler
from scipy.sparse import hstack, csr_matrix
from textblob import TextBlob
import joblib

import sys
sys.path.append(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
from config import FEATURE_CONFIG, PROCESSED_DATA_DIR


# ============================================================
# LINGUISTIC FEATURE EXTRACTION
# ============================================================

def _avg_word_length(text):
    """Average word length in the text."""
    words = text.split()
    if len(words) == 0:
        return 0.0
    return np.mean([len(w) for w in words])


def _avg_sentence_length(text):
    """Average sentence length (in words)."""
    from nltk.tokenize import sent_tokenize
    sentences = sent_tokenize(text)
    if len(sentences) == 0:
        return 0.0
    return np.mean([len(s.split()) for s in sentences])


def _vocab_richness(text):
    """Type-token ratio (unique words / total words)."""
    words = text.lower().split()
    if len(words) == 0:
        return 0.0
    return len(set(words)) / len(words)


def _punctuation_density(text):
    """Ratio of punctuation characters to total characters."""
    if len(text) == 0:
        return 0.0
    punct_count = sum(1 for c in text if c in '.,!?;:\'"-()[]{}')
    return punct_count / len(text)


def _exclamation_ratio(text):
    """Ratio of exclamation marks to total characters."""
    if len(text) == 0:
        return 0.0
    return text.count('!') / len(text)


def _question_ratio(text):
    """Ratio of question marks to total characters."""
    if len(text) == 0:
        return 0.0
    return text.count('?') / len(text)


def _capital_ratio(text):
    """Ratio of uppercase characters to total alphabetic characters."""
    alpha_chars = [c for c in text if c.isalpha()]
    if len(alpha_chars) == 0:
        return 0.0
    return sum(1 for c in alpha_chars if c.isupper()) / len(alpha_chars)


def _first_person_ratio(text):
    """Ratio of first-person pronouns to total words."""
    words = text.lower().split()
    if len(words) == 0:
        return 0.0
    first_person = {'i', 'me', 'my', 'mine', 'myself', 'we', 'us', 'our', 'ours'}
    count = sum(1 for w in words if w in first_person)
    return count / len(words)


def _sentiment_polarity(text):
    """TextBlob sentiment polarity (-1 to 1)."""
    try:
        return TextBlob(text).sentiment.polarity
    except Exception:
        return 0.0


def _sentiment_subjectivity(text):
    """TextBlob sentiment subjectivity (0 to 1)."""
    try:
        return TextBlob(text).sentiment.subjectivity
    except Exception:
        return 0.5


def _review_length(text):
    """Number of words in the review."""
    return len(text.split())


def _unique_word_ratio(text):
    """Ratio of unique words to total (same as vocab richness but on original)."""
    words = text.split()
    if len(words) == 0:
        return 0.0
    return len(set(words)) / len(words)


def _repeated_word_ratio(text):
    """Ratio of words that appear more than once."""
    words = text.lower().split()
    if len(words) == 0:
        return 0.0
    from collections import Counter
    counts = Counter(words)
    repeated = sum(1 for c in counts.values() if c > 1)
    return repeated / len(counts) if len(counts) > 0 else 0.0


def _all_caps_word_ratio(text):
    """Ratio of ALL-CAPS words to total words."""
    words = text.split()
    if len(words) == 0:
        return 0.0
    caps_words = sum(1 for w in words if w.isupper() and len(w) > 1)
    return caps_words / len(words)


def _digit_ratio(text):
    """Ratio of digits to total characters."""
    if len(text) == 0:
        return 0.0
    return sum(1 for c in text if c.isdigit()) / len(text)


def extract_linguistic_features(df, text_column="review_text"):
    """
    Extract linguistic / stylometric features from review text.

    Parameters
    ----------
    df : pd.DataFrame
        DataFrame with review text.
    text_column : str
        Column containing the original review text.

    Returns
    -------
    pd.DataFrame
        DataFrame with linguistic feature columns.
    """
    from tqdm import tqdm
    print("Extracting linguistic features...")

    feature_funcs = {
        "avg_word_length": _avg_word_length,
        "avg_sentence_length": _avg_sentence_length,
        "vocab_richness": _vocab_richness,
        "punctuation_density": _punctuation_density,
        "exclamation_ratio": _exclamation_ratio,
        "question_ratio": _question_ratio,
        "capital_ratio": _capital_ratio,
        "first_person_ratio": _first_person_ratio,
        "sentiment_polarity": _sentiment_polarity,
        "sentiment_subjectivity": _sentiment_subjectivity,
        "review_length": _review_length,
        "unique_word_ratio": _unique_word_ratio,
        "repeated_word_ratio": _repeated_word_ratio,
        "all_caps_word_ratio": _all_caps_word_ratio,
        "digit_ratio": _digit_ratio,
    }

    features_df = pd.DataFrame()

    for feat_name, func in tqdm(feature_funcs.items(), desc="Linguistic features"):
        features_df[feat_name] = df[text_column].apply(func)

    # Add rating as a feature
    if "rating" in df.columns:
        features_df["rating"] = df["rating"].values

    print(f"Extracted {len(features_df.columns)} linguistic features.")
    return features_df


# ============================================================
# TF-IDF FEATURE EXTRACTION
# ============================================================

def extract_tfidf_features(train_texts, test_texts=None):
    """
    Extract TF-IDF features from text.

    Parameters
    ----------
    train_texts : pd.Series
        Training text data (preprocessed).
    test_texts : pd.Series, optional
        Test text data.

    Returns
    -------
    tuple
        (X_train_tfidf, X_test_tfidf, word_vectorizer, char_vectorizer)
    """
    print("Extracting TF-IDF features...")

    # Word-level TF-IDF
    word_vectorizer = TfidfVectorizer(
        max_features=FEATURE_CONFIG["tfidf_max_features"],
        ngram_range=FEATURE_CONFIG["tfidf_ngram_range"],
        min_df=FEATURE_CONFIG["tfidf_min_df"],
        max_df=FEATURE_CONFIG["tfidf_max_df"],
        sublinear_tf=True,
    )

    X_train_word = word_vectorizer.fit_transform(train_texts)
    print(f"  Word TF-IDF shape: {X_train_word.shape}")

    # Character-level TF-IDF
    char_vectorizer = TfidfVectorizer(
        analyzer='char_wb',
        max_features=FEATURE_CONFIG["char_max_features"],
        ngram_range=FEATURE_CONFIG["char_ngram_range"],
        min_df=FEATURE_CONFIG["tfidf_min_df"],
        max_df=FEATURE_CONFIG["tfidf_max_df"],
        sublinear_tf=True,
    )

    X_train_char = char_vectorizer.fit_transform(train_texts)
    print(f"  Char TF-IDF shape: {X_train_char.shape}")

    # Combine word + char TF-IDF
    X_train_tfidf = hstack([X_train_word, X_train_char])
    print(f"  Combined TF-IDF shape: {X_train_tfidf.shape}")

    X_test_tfidf = None
    if test_texts is not None:
        X_test_word = word_vectorizer.transform(test_texts)
        X_test_char = char_vectorizer.transform(test_texts)
        X_test_tfidf = hstack([X_test_word, X_test_char])

    return X_train_tfidf, X_test_tfidf, word_vectorizer, char_vectorizer


# ============================================================
# COMBINED FEATURE MATRIX
# ============================================================

def build_feature_matrix(df_train, df_test=None, text_col="processed_text",
                          original_text_col="review_text"):
    """
    Build the complete feature matrix combining TF-IDF + linguistic features.

    Parameters
    ----------
    df_train : pd.DataFrame
        Training DataFrame.
    df_test : pd.DataFrame, optional
        Test DataFrame.
    text_col : str
        Column with preprocessed text for TF-IDF.
    original_text_col : str
        Column with original text for linguistic features.

    Returns
    -------
    dict
        Dictionary with feature matrices, labels, vectorizers, and scaler.
    """
    print("\n" + "=" * 60)
    print("BUILDING FEATURE MATRIX")
    print("=" * 60)

    # 1. TF-IDF features
    test_texts = df_test[text_col] if df_test is not None else None
    X_train_tfidf, X_test_tfidf, word_vec, char_vec = extract_tfidf_features(
        df_train[text_col], test_texts
    )

    # 2. Linguistic features
    ling_train = extract_linguistic_features(df_train, original_text_col)
    ling_test = None
    if df_test is not None:
        ling_test = extract_linguistic_features(df_test, original_text_col)

    # 3. Scale linguistic features
    scaler = StandardScaler()
    ling_train_scaled = scaler.fit_transform(ling_train.values)
    ling_train_sparse = csr_matrix(ling_train_scaled)

    ling_test_scaled = None
    ling_test_sparse = None
    if ling_test is not None:
        ling_test_scaled = scaler.transform(ling_test.values)
        ling_test_sparse = csr_matrix(ling_test_scaled)

    # 4. Combine all features
    X_train_combined = hstack([X_train_tfidf, ling_train_sparse])
    X_test_combined = None
    if X_test_tfidf is not None and ling_test_sparse is not None:
        X_test_combined = hstack([X_test_tfidf, ling_test_sparse])

    y_train = df_train["label"].values
    y_test = df_test["label"].values if df_test is not None else None

    print(f"\nFinal feature matrix shapes:")
    print(f"  X_train: {X_train_combined.shape}")
    if X_test_combined is not None:
        print(f"  X_test:  {X_test_combined.shape}")

    # Save vectorizers and scaler
    artifacts = {
        "word_vectorizer": word_vec,
        "char_vectorizer": char_vec,
        "scaler": scaler,
    }
    artifacts_path = os.path.join(PROCESSED_DATA_DIR, "feature_artifacts.pkl")
    joblib.dump(artifacts, artifacts_path)
    print(f"Feature artifacts saved to {artifacts_path}")

    return {
        # Combined features (for classical ML)
        "X_train": X_train_combined,
        "X_test": X_test_combined,
        "y_train": y_train,
        "y_test": y_test,
        # TF-IDF only
        "X_train_tfidf": X_train_tfidf,
        "X_test_tfidf": X_test_tfidf,
        # Linguistic only
        "X_train_ling": ling_train_scaled,
        "X_test_ling": ling_test_scaled,
        "ling_feature_names": list(ling_train.columns),
        # Vectorizers / Scaler
        "word_vectorizer": word_vec,
        "char_vectorizer": char_vec,
        "scaler": scaler,
    }
